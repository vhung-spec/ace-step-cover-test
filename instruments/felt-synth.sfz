<region> sample=*sine transpose=28 tune=-6 volume=-26 ampeg_sustain=0 ampeg_decay=1.0
<region> sample=*sine transpose=31 tune=12 volume=-30 ampeg_sustain=0 ampeg_decay=0.75
<region> sample=*noise volume=-30 ampeg_attack=0.001 ampeg_decay=0.04 ampeg_sustain=0 ampeg_release=0.03 fil_type=lpf_2p cutoff=900 fil_keycenter=60 fil_keytrack=100
<group> lokey=80 hikey=127
<region> sample=*sine transpose=0 tune=0 volume=0 ampeg_sustain=0 ampeg_decay=3.0
<region> sample=*sine transpose=12 tune=1 volume=-10 ampeg_sustain=0 ampeg_decay=1.8
<region> sample=*sine transpose=19 tune=5 volume=-18 ampeg_sustain=0 ampeg_decay=1.2
