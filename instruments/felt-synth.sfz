<region> sample=*sine transpose=24 tune=5 volume=-11 ampeg_sustain=0 ampeg_decay=1.95
<region> sample=*sine transpose=28 tune=-6 volume=-16 ampeg_sustain=0 ampeg_decay=1.3
<region> sample=*sine transpose=31 tune=12 volume=-20 ampeg_sustain=0 ampeg_decay=0.975
<region> sample=*noise volume=-30 ampeg_attack=0.001 ampeg_decay=0.04 ampeg_sustain=0 ampeg_release=0.03 fil_type=lpf_2p cutoff=900 fil_keycenter=60 fil_keytrack=100
<group> lokey=60 hikey=79
<region> sample=*sine transpose=0 tune=0 volume=0 ampeg_sustain=0 ampeg_decay=5.0
<region> sample=*sine transpose=12 tune=1 volume=-7 ampeg_sustain=0 ampeg_decay=3.0
<region> sample=*sine transpose=19 tune=5 volume=-14 ampeg_sustain=0 ampeg_decay=2.0
