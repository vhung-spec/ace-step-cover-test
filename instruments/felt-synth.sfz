// A soft piano made by sfizz's own oscillators (no recording, no licence), as
// felt hammers sound: six partials, stretched a little sharp as a piano's
// strings are, each dying sooner than the one under it; the felt's soft knock;
// a low-pass that opens as the key is struck harder, and follows the pitch
// halfway. As in a piano, a low note's fundamental is weak and its partials
// carry it (pure low tones only boom, and a phone does not play them); high
// notes are nearly pure. Lower notes ring longer.
<global>
amp_veltrack=70
ampeg_attack=0.003
ampeg_release=0.25
fil_type=lpf_2p
cutoff=2200
fil_keycenter=60
fil_keytrack=50
fil_veltrack=1800

<group> lokey=0 hikey=47
<region> sample=*sine transpose=0 tune=0 volume=-10 ampeg_sustain=0 ampeg_decay=8.0
<region> sample=*sine transpose=12 tune=1 volume=-2 ampeg_sustain=0 ampeg_decay=4.8
<region> sample=*sine transpose=19 tune=5 volume=-3 ampeg_sustain=0 ampeg_decay=3.2
<region> sample=*sine transpose=24 tune=5 volume=-7 ampeg_sustain=0 ampeg_decay=2.4
<region> sample=*sine transpose=28 tune=-6 volume=-11 ampeg_sustain=0 ampeg_decay=1.6
<region> sample=*sine transpose=31 tune=12 volume=-14 ampeg_sustain=0 ampeg_decay=1.2
<region> sample=*noise volume=-30 ampeg_attack=0.001 ampeg_decay=0.04 ampeg_sustain=0 ampeg_release=0.03 fil_type=lpf_2p cutoff=900 fil_keycenter=60 fil_keytrack=100
<group> lokey=48 hikey=59
<region> sample=*sine transpose=0 tune=0 volume=-4 ampeg_sustain=0 ampeg_decay=6.5
<region> sample=*sine transpose=12 tune=1 volume=-3 ampeg_sustain=0 ampeg_decay=3.9
