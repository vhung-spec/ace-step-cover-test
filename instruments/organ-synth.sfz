// A soft pipe organ made by sfizz's own oscillators, so no recording and no
// licence is needed (the user asked to try simulated instruments): a stopped
// 8' flute (a nearly pure tone, its third harmonic soft, as the sampled quiet
// manual's) and a 4' flute an octave up, tuned a few cents apart so the two
// ranks breathe together. Each pipe speaks over 60 ms with a breath of noise
// (its chiff) and dies over 0.3 s. Pipes do not follow the velocity: the swell
// (expression) shapes them.
<global>
amp_veltrack=0
ampeg_attack=0.06
ampeg_release=0.3
amp_keycenter=60
amp_keytrack=-0.08

<region> sample=*sine transpose=0 tune=0 volume=0
<region> sample=*sine transpose=19 tune=3 volume=-15
<region> sample=*sine transpose=12 tune=3 volume=-10
<region> sample=*sine transpose=24 tune=3 volume=-28
<region> sample=*noise volume=-34 ampeg_attack=0.004 ampeg_decay=0.07 ampeg_sustain=0 ampeg_release=0.05 fil_type=bpf_2p cutoff=1046 fil_keycenter=60 fil_keytrack=100 resonance=6
