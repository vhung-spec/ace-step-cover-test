// The soft pipe organ's pedal (organ-synth.sfz), by sfizz's own oscillators: an
// 8' stopped flute with its octave and its third harmonic soft over it, no 16'
// rank (the user found the organ heavy); it speaks over 80 ms.
<global>
amp_veltrack=0
ampeg_attack=0.08
ampeg_release=0.35
amp_keycenter=60
amp_keytrack=-0.08

<region> sample=*sine transpose=0 tune=0 volume=0
<region> sample=*sine transpose=12 tune=2 volume=-12
<region> sample=*sine transpose=19 tune=3 volume=-22
<region> sample=*noise volume=-40 ampeg_attack=0.004 ampeg_decay=0.07 ampeg_sustain=0 ampeg_release=0.05 fil_type=bpf_2p cutoff=1046 fil_keycenter=60 fil_keytrack=100 resonance=6
