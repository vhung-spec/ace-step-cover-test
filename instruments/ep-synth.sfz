// A tine electric piano made by sfizz's own oscillators (no recording, no
// licence): its tone's fundamental and second harmonic ringing long, the third
// shorter, and a tine's bright, slightly inharmonic overtone barking softly for a
// tenth of a second, more when struck hard; a soft knock of the hammer; lower notes
// ring longer. The mixer gives it its chorus, as the sampled Rhodes's.
<global>
amp_veltrack=85
ampeg_attack=0.002
ampeg_release=0.35

<group> lokey=0 hikey=59
<region> sample=*sine transpose=0 tune=0 volume=0 ampeg_sustain=0 ampeg_decay=6.3
<region> sample=*sine transpose=12 tune=0 volume=-9 ampeg_sustain=0 ampeg_decay=3.15
<region> sample=*sine transpose=19 tune=2 volume=-20 ampeg_sustain=0 ampeg_decay=1.89
<region> sample=*sine transpose=32 tune=-22 volume=-33 ampeg_sustain=0 ampeg_decay=0.189
<region> sample=*sine transpose=32 tune=-22 volume=-27 ampeg_sustain=0 ampeg_decay=0.189 lovel=84
<region> sample=*sine transpose=42 tune=-2 volume=-38 ampeg_sustain=0 ampeg_decay=0.126 lovel=96
<region> sample=*noise volume=-36 ampeg_attack=0.001 ampeg_decay=0.03 ampeg_sustain=0 ampeg_release=0.02 fil_type=lpf_2p cutoff=1500 fil_keycenter=60 fil_keytrack=100
<group> lokey=60 hikey=79
<region> sample=*sine transpose=0 tune=0 volume=0 ampeg_sustain=0 ampeg_decay=4.5
<region> sample=*sine transpose=12 tune=0 volume=-9 ampeg_sustain=0 ampeg_decay=2.25
<region> sample=*sine transpose=19 tune=2 volume=-20 ampeg_sustain=0 ampeg_decay=1.35
<region> sample=*sine transpose=32 tune=-22 volume=-33 ampeg_sustain=0 ampeg_decay=0.135
<region> sample=*sine transpose=32 tune=-22 volume=-27 ampeg_sustain=0 ampeg_decay=0.135 lovel=84
<region> sample=*sine transpose=42 tune=-2 volume=-38 ampeg_sustain=0 ampeg_decay=0.09 lovel=96
<region> sample=*noise volume=-36 ampeg_attack=0.001 ampeg_decay=0.03 ampeg_sustain=0 ampeg_release=0.02 fil_type=lpf_2p cutoff=1500 fil_keycenter=60 fil_keytrack=100
<group> lokey=80 hikey=127
<region> sample=*sine transpose=0 tune=0 volume=0 ampeg_sustain=0 ampeg_decay=2.7
<region> sample=*sine transpose=12 tune=0 volume=-9 ampeg_sustain=0 ampeg_decay=1.35
<region> sample=*sine transpose=19 tune=2 volume=-20 ampeg_sustain=0 ampeg_decay=0.81
<region> sample=*sine transpose=32 tune=-22 volume=-33 ampeg_sustain=0 ampeg_decay=0.081
<region> sample=*sine transpose=32 tune=-22 volume=-27 ampeg_sustain=0 ampeg_decay=0.081 lovel=84
<region> sample=*sine transpose=42 tune=-2 volume=-38 ampeg_sustain=0 ampeg_decay=0.054 lovel=96
<region> sample=*noise volume=-36 ampeg_attack=0.001 ampeg_decay=0.03 ampeg_sustain=0 ampeg_release=0.02 fil_type=lpf_2p cutoff=1500 fil_keycenter=60 fil_keytrack=100
